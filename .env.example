# Neon : DATABASE_URL = chaîne « pooled » (hôte -pooler) + &pgbouncer=true ; DIRECT_URL = chaîne directe
DATABASE_URL="postgresql://USER:MOT_DE_PASSE@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:MOT_DE_PASSE@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Mot de passe de la plateforme de contrôle (/admin)
ADMIN_PASSWORD="choisir-un-mot-de-passe-solide"
# 32 caractères aléatoires au moins (signature du cookie de session)
SESSION_SECRET="longue-chaine-aleatoire-de-32-caracteres-minimum"
# Backblaze B2 (photos) : compartiment privé, clé limitée à ce compartiment
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET=""
B2_ENDPOINT="https://s3.<region>.backblazeb2.com"
